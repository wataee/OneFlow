# ==============================================================================
# SAAS PLATFORM FOUNDATION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENV=development
DEBUG=true
APP_NAME="OneFlow"
API_V1_PREFIX="/api/v1"

# Database Configuration
# Local SQLite default: sqlite+aiosqlite:///./saas.db
# PostgreSQL Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/saas_foundation
DATABASE_URL=sqlite+aiosqlite:///./saas.db

# Celery & Redis Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# When True, Celery tasks execute synchronously in-process (ideal for testing without Redis)
CELERY_TASK_ALWAYS_EAGER=false
TASK_PROCESSING_TIMEOUT_SECONDS=300
MAX_TASK_RETRIES=3

# JWT & Authentication Security
JWT_SECRET_KEY=change-me-super-secret-key-min-32-chars-for-hmac-sha256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=refresh_token
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# AI Service & Human-in-the-Loop Review
# Confidence threshold: tasks with confidence strictly below this threshold transition to REVIEW
REVIEW_CONFIDENCE_THRESHOLD=0.85
DEMO_MODE=true
AI_PROVIDER=demo
# Optional LLM Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Storage Backend
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=26214400

# CORS Configuration (JSON array string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost"]

# 1C:Enterprise OData Access Configuration
# Default is strictly READ_ONLY_MODE=true for security
ONEC_READ_ONLY_MODE=true
ONEC_MAX_RISK_LEVEL=ANALYTICS_READ
ONEC_OUTPUT_MAX_ROWS=100
# Global demo/dev 1C credentials (in production, stored per organization in DB)
ONEC_ODATA_URL=http://localhost:8314/accounting/
ONEC_USERNAME=
ONEC_PASSWORD=
# Fernet symmetric encryption key for per-tenant stored credentials.
# In production, generate a dedicated 32-byte urlsafe-base64 key.
ONEC_CREDENTIALS_ENCRYPTION_KEY=

# Execution Reliability & Tool Gateway Hardening
ONEC_TOOL_TIMEOUT_SECONDS=30
ONEC_TOOL_RETRIES=1

